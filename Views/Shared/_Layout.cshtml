@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - TechMove GLMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechMoveLogisticsApplication.styles.css" asp-append-version="true" />
</head>
<body>
    @if (!isAuthenticated)
    {
        <main role="main" class="auth-shell">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="app-shell">
        <aside class="sidebar">
            @if (isAdmin)
            {
                <a class="brand-lockup" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">TM</span>
                    <span>
                        <strong>TechMove</strong>
                        <small>Global Logistics</small>
                    </span>
                </a>
            }
            else
            {
                <a class="brand-lockup" asp-area="" asp-controller="Contracts" asp-action="Index">
                    <span class="brand-mark">TM</span>
                    <span>
                        <strong>TechMove</strong>
                        <small>Global Logistics</small>
                    </span>
                </a>
            }

            <nav class="side-nav" aria-label="Main navigation">
                <p class="nav-label">Main Menu</p>
                @if (isAdmin)
                {
                    <a class="@Active("Home")" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="nav-icon">D</span>
                        Dashboard
                    </a>
                }
                <a class="@Active("Clients")" asp-area="" asp-controller="Clients" asp-action="Index">
                    <span class="nav-icon">CL</span>
                    Clients
                </a>
                <a class="@Active("Contracts")" asp-area="" asp-controller="Contracts" asp-action="Index">
                    <span class="nav-icon">CT</span>
                    Contracts
                </a>
                <a class="@Active("ServiceRequests")" asp-area="" asp-controller="ServiceRequests" asp-action="Index">
                    <span class="nav-icon">SR</span>
                    Requests
                </a>

                <p class="nav-label">Internal Tools</p>
                <a class="@Active("Invoices")" asp-area="" asp-controller="Invoices" asp-action="Index">
                    <span class="nav-icon">IN</span>
                    Invoices
                </a>
                @if (isAdmin)
                {
                    <a class="@Active("Audit")" asp-area="" asp-controller="Audit" asp-action="Index">
                        <span class="nav-icon">AU</span>
                        Audit Logs
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit" class="btn btn-outline-primary sidebar-signout">Sign Out</button>
                </form>
            </div>
        </aside>

        <div class="workspace">
            <main role="main" class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
