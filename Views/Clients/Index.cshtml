@model IEnumerable<Client>

@{
    ViewData["Title"] = "Clients";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Contract stakeholders</p>
        <h1>Clients</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add Client</a>
</section>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Contact</th>
                <th>Region</th>
                <th>Contracts</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Name</td>
                    <td>@client.ContactDetails</td>
                    <td>@client.Region</td>
                    <td>@client.Contracts.Count</td>
                    <td><a asp-action="Details" asp-route-id="@client.ClientId">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
