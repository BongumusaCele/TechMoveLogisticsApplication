@model ContractEditViewModel

@{
    ViewData["Title"] = "Edit Contract";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">@Model.ContractType contract</p>
        <h1>Edit Contract</h1>
        <p class="heading-copy">Update contract details, workflow status, SLA dates, and agreement documents.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model.ContractId">Back to Details</a>
</section>

<form asp-action="Edit" asp-route-id="@Model.ContractId" method="post" enctype="multipart/form-data" class="form-panel edit-contract-panel">
    <input asp-for="ContractId" type="hidden" />
    <input asp-for="ContractType" type="hidden" />
    <input asp-for="ExistingAgreementFileName" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-section-title">
        <span>01</span>
        <div>
            <h2>Contract Profile</h2>
            <p>Keep the core agreement details aligned with the client record.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ClientId" class="form-label"></label>
            <select asp-for="ClientId" asp-items="Model.ClientOptions" class="form-select">
                <option value="">Select client</option>
            </select>
            <span asp-validation-for="ClientId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ContractType" class="form-label"></label>
            <input value="@Model.ContractType" class="form-control" disabled />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()" class="form-select"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ServiceLevel" class="form-label"></label>
            <input asp-for="ServiceLevel" class="form-control" />
            <span asp-validation-for="ServiceLevel" class="text-danger"></span>
        </div>
    </div>

    @if (Model.ContractType == ContractType.International)
    {
        <div class="form-section-title">
            <span>02</span>
            <div>
                <h2>International Rules</h2>
                <p>Currency and exchange behavior for global logistics agreements.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="CurrencyCode" class="form-label"></label>
                <input asp-for="CurrencyCode" class="form-control" />
                <span asp-validation-for="CurrencyCode" class="text-danger"></span>
            </div>
            <div class="col-md-8 mb-3">
                <label asp-for="ExchangeRule" class="form-label"></label>
                <input asp-for="ExchangeRule" class="form-control" />
                <span asp-validation-for="ExchangeRule" class="text-danger"></span>
            </div>
        </div>
    }

    @if (Model.ContractType == ContractType.Premium)
    {
        <div class="form-section-title">
            <span>02</span>
            <div>
                <h2>Premium Priority</h2>
                <p>Priority level used by premium workflow and monitoring rules.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PriorityLevel" class="form-label"></label>
                <input asp-for="PriorityLevel" class="form-control" />
                <span asp-validation-for="PriorityLevel" class="text-danger"></span>
            </div>
        </div>
    }

    <div class="form-section-title">
        <span>03</span>
        <div>
            <h2>Signed Agreement</h2>
            <p>Upload a new PDF only when the stored agreement must be replaced.</p>
        </div>
    </div>

    <div class="document-strip">
        <div>
            <span>Current Agreement</span>
            <strong>@(Model.ExistingAgreementFileName ?? "No agreement uploaded")</strong>
        </div>
        <input asp-for="SignedAgreement" type="file" accept="application/pdf" class="form-control" />
    </div>
    <span asp-validation-for="SignedAgreement" class="text-danger"></span>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-outline-primary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
