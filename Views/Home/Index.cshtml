@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-heading dashboard-heading">
    <div>
        <p class="eyebrow">Today at TechMove</p>
        <h1>Good day, operations team</h1>
        <p class="heading-copy">A live view of contracts, service requests, billing, and compliance activity.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Contracts" asp-action="Create">Create Contract</a>
</section>

<div class="metrics-grid">
    <div class="metric accent-blue">
        <span>Registered Clients</span>
        <strong>@Model.ClientCount.ToString("N0")</strong>
        <small>Client records in the GLMS hub</small>
    </div>
    <div class="metric accent-teal">
        <span>Active Contracts</span>
        <strong>@Model.ActiveContractCount.ToString("N0")</strong>
        <small>Valid agreements available for requests</small>
    </div>
    <div class="metric accent-violet">
        <span>Service Requests</span>
        <strong>@Model.ServiceRequestCount.ToString("N0")</strong>
        <small>Approved or submitted workflow items</small>
    </div>
    <div class="metric accent-pink">
        <span>Invoices</span>
        <strong>@Model.InvoiceCount.ToString("N0")</strong>
        <small>Finance records generated from requests</small>
    </div>
</div>

<section class="panel dashboard-section">
    <div class="section-title">
        <div>
            <h2>Recent Contracts</h2>
            <p>Latest agreements in the repository</p>
        </div>
        <a asp-controller="Contracts" asp-action="Index">All</a>
    </div>
    <div class="table-responsive flush-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Type</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contract in Model.RecentContracts)
                {
                    <tr>
                        <td>
                            <strong>@contract.Client?.Name</strong>
                            <small>@contract.EndDate.ToString("yyyy-MM-dd")</small>
                        </td>
                        <td>@contract.ContractType</td>
                        <td><span class="status">@contract.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="panel dashboard-section">
    <div class="section-title">
        <div>
            <h2>Recent Service Requests</h2>
            <p>Validated operations with local ZAR costing</p>
        </div>
        <a asp-controller="ServiceRequests" asp-action="Index">All requests</a>
    </div>
    <div class="table-responsive flush-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Request</th>
                    <th>Status</th>
                    <th>Local Cost</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.RecentRequests)
                {
                    <tr>
                        <td>@request.Contract?.Client?.Name</td>
                        <td>@request.RequestType</td>
                        <td><span class="status">@request.Status</span></td>
                        <td>@request.Cost.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
