@{
    ViewData["Title"] = "Access Denied";
}

<section class="auth-panel">
    <div class="auth-card">
        <p class="eyebrow">Authorization required</p>
        <h1>Access denied</h1>
        <p class="heading-copy">Your account does not have permission to view this page.</p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary w-100" asp-controller="Contracts" asp-action="Index">Go to Contracts</a>
        }
        else
        {
            <a class="btn btn-primary w-100" asp-action="Login">Sign In</a>
        }
    </div>
</section>
